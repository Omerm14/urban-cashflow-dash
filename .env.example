# ─── Server (.env.local) ─────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret
ADMIN_EMAIL=you@example.com

# ─── Attachment storage backend ──────────────────────────────────────────────
# Where NEW invoice originals are stored. Leave unset (or 'supabase') to keep
# using Supabase Storage. Set to 'r2' to send new uploads to Cloudflare R2.
# Existing files are served from whichever backend each row records, so you can
# flip this and run `node server/scripts/migrateToR2.js` to move old files over.
STORAGE_BACKEND=supabase

# Cloudflare R2 (S3-compatible) — required only when STORAGE_BACKEND=r2.
# Create an R2 bucket + API token in the Cloudflare dashboard.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=invoice-attachments
# Optional explicit endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# Secret for the cron endpoints (/api/cron/sync, /api/cron/gc, /api/cron/billing).
# Send as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=your-cron-secret

# ─── Hyp payment gateway (Israeli market billing) ────────────────────────────
# No self-serve checkout exists — an admin generates a payment link per client
# (see server/routes/admin.js generateBillingLink). Get these from Hyp support;
# the Relay endpoint hostname can vary by environment, confirm with Hyp.
HYP_ENDPOINT=https://your-hyp-environment-url/xpo/Relay
HYP_TERMINAL_NUMBER=0123456789
HYP_MID=your-merchant-id
HYP_API_USER=your-hyp-api-username
HYP_API_PASSWORD=your-hyp-api-password

# WhatsApp Cloud API webhook verification token (Meta webhook setup).
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token

# ─── Google OAuth2 (Drive + Gmail integrations) ───────────────────────────────
# Use the SAME Client ID and Secret already configured in your Supabase project:
#   Supabase Dashboard → Authentication → Providers → Google → Client ID / Client Secret
#
# Then in Google Cloud Console (console.cloud.google.com) → APIs & Services → Credentials
# → Edit the OAuth 2.0 Client → add these two Authorized redirect URIs:
#   • http://localhost:3001/api/integrations/google/callback   (local dev)
#   • https://your-domain.vercel.app/api/integrations/google/callback   (production)
#
# Also enable these APIs in Google Cloud Console → APIs & Services → Library:
#   • Google Drive API
#   • Gmail API
#
# Branch / preview URLs do NOT need to be registered — the OAuth callback redirects
# back to whichever frontend URL triggered the flow (passed via OAuth state).

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Redirect URI that IS registered in Google Cloud Console (production or local).
# For local dev: http://localhost:3001/api/integrations/google/callback
# For Vercel:    https://your-domain.vercel.app/api/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# ─── Branch / preview testing ────────────────────────────────────────────────
# After deploying a branch to Vercel, add its preview URL to Supabase:
#   Supabase Dashboard → Authentication → URL Configuration → Additional Redirect URLs
#   Add: https://your-project-git-branchname-username.vercel.app
# This is required for Google sign-in (the auth login flow) to redirect back
# to the preview URL instead of the production site.
#
# The GOOGLE_REDIRECT_URI above only needs the production URL — Drive/Gmail OAuth
# returns to production then auto-redirects to whichever frontend triggered it.

# ─── Frontend (Vite picks up VITE_ prefix) ───────────────────────────────────

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_ADMIN_EMAIL=you@example.com
