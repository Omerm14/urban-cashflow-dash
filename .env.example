# ─── Server (.env.local) ─────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret
ADMIN_EMAIL=you@example.com

# ─── Google OAuth2 (Drive + Gmail integrations) ───────────────────────────────
# Use the SAME Client ID and Secret already configured in your Supabase project:
#   Supabase Dashboard → Authentication → Providers → Google → Client ID / Client Secret
#
# Then in Google Cloud Console (console.cloud.google.com) → APIs & Services → Credentials
# → Edit the OAuth 2.0 Client → add these two Authorized redirect URIs:
#   • http://localhost:3001/api/integrations/google/callback   (local dev)
#   • https://your-domain.vercel.app/api/integrations/google/callback   (production)
#
# Also enable these APIs in Google Cloud Console → APIs & Services → Library:
#   • Google Drive API
#   • Gmail API
#
# Branch / preview URLs do NOT need to be registered — the OAuth callback redirects
# back to whichever frontend URL triggered the flow (passed via OAuth state).

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Drive Picker (required for the interactive folder picker in integration setup)
# VITE_GOOGLE_APP_ID — The Google Cloud project number (numeric).
#   Find it: Cloud Console → select your project → Project number (not Project ID)
# VITE_GOOGLE_API_KEY — A browser API key with Google Picker API enabled.
#   Find it: Cloud Console → APIs & Services → Credentials → Create → API Key
#   Restrict it to: HTTP referrers (your domain) + APIs: Google Picker API
VITE_GOOGLE_APP_ID=your-project-number
VITE_GOOGLE_API_KEY=your-browser-api-key

# Redirect URI that IS registered in Google Cloud Console (production or local).
# For local dev: http://localhost:3001/api/integrations/google/callback
# For Vercel:    https://your-domain.vercel.app/api/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# ─── Branch / preview testing ────────────────────────────────────────────────
# After deploying a branch to Vercel, add its preview URL to Supabase:
#   Supabase Dashboard → Authentication → URL Configuration → Additional Redirect URLs
#   Add: https://your-project-git-branchname-username.vercel.app
# This is required for Google sign-in (the auth login flow) to redirect back
# to the preview URL instead of the production site.
#
# The GOOGLE_REDIRECT_URI above only needs the production URL — Drive/Gmail OAuth
# returns to production then auto-redirects to whichever frontend triggered it.

# ─── Frontend (Vite picks up VITE_ prefix) ───────────────────────────────────

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_ADMIN_EMAIL=you@example.com
