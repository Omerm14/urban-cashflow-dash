{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/login",    "destination": "/app.html" },
    { "source": "/app",      "destination": "/app.html" },
    { "source": "/app/(.*)", "destination": "/app.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "bodyParser": false
    }
  }
}
